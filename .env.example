# Runtime
APP_ENVIRONMENT=production
DEBUG=false
APP_SERVICE_NAME=wboz
API_HOST=0.0.0.0
API_PORT=8080
REQUESTS_TIMEOUT=10

# Bot
BOT_TOKEN=replace-with-real-token
DEFAULT_THRESHOLD=10
DEFAULT_CHECK_INTERVAL=30
THRESHOLD_ALERT_COOLDOWN_HOURS=24

# Database (used by app and alembic)
POSTGRES_DB=wboz
POSTGRES_USER=wboz
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://wboz:replace-with-strong-password@db:5432/wboz
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30

# Reverse proxy
DOMAIN=example.com
LETSENCRYPT_EMAIL=devops@example.com

# Deployed image
WBOZ_IMAGE=ghcr.io/your-org/wboz:latest
